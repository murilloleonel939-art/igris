# IGRIS Frontend - Simple Dockerfile (Alternative)
# Más simple y compatible con Coolify

FROM node:18-alpine

WORKDIR /app

# Copiar package.json
COPY web/package.json ./

# Instalar todas las dependencias (incluyendo devDeps para build)
RUN npm install --legacy-peer-deps

# Copiar código fuente
COPY web/ .

# Build Vue 3
RUN npm run build

# Puerto
EXPOSE 3000

# Variables de entorno
ENV NODE_ENV=production
ENV PORT=3000
# OJO: el frontend compilado NO lee VITE_API_URL. El navegador usa la URL escrita
# dentro de web/src/api.js y web/src/userApi.js. Esta variable solo la usa el
# proxy del servidor de desarrollo (vite.config.js). Para cambiar el backend hay
# que editar esos dos archivos y volver a compilar.
ENV VITE_API_URL=https://igris.zottagroup.com

# Start
CMD ["npm", "start"]
