{
  "name": "igris-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación de escritorio de Igris para usuarios",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.zottagroup.igris",
    "productName": "Igris",
    "files": ["main.cjs", "preload.cjs", "voice_worker.py", "requirements.txt"],
    "extraResources": ["voice_worker.exe"],
    "win": {
      "target": ["portable"]
    }
  }
}
