{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IGRIS",
  "version": "1.0.0",
  "identifier": "com.zottagroup.igris.chat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://webigris.zottagroup.com"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Chat de IGRIS",
    "longDescription": "Ventana de escritorio del chat de IGRIS con avatar y voz.",
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "IGRIS"
      }
    }
  }
}
