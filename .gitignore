# Environment
.env
.env.local
.env.test
.env.*.local

# Dependencies
node_modules/
web/node_modules/

# Build output
dist/
web/dist/
desktop/node_modules/
desktop/.cache/
desktop/.npm-cache/

# El frontend del ejecutable de escritorio se versiona: Tauri lo necesita
# para compilar y no hay un paso previo que lo genere en el workflow.
!desktop/dist/
!desktop/dist/**

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Base de datos local (SQLite)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Documentos generados por los usuarios (create_document)
documents/

# Sesiones locales
*.ses

# Herramientas del entorno de desarrollo
.npm-cache/
.uv-cache/
.tools/
.tmp/

# Grafo de conocimiento de Graphify (herramienta de análisis local).
# Es un artefacto derivado: se regenera con `graphify update .` en segundos y
# sin coste de LLM. Versionarlo supondría ~11 MB de JSON/HTML con un diff
# distinto en cada commit, que ensuciaría el historial sin aportar nada al
# proyecto. Cada quien lo reconstruye en su máquina cuando lo necesite.
# OJO: esto deja inerte el merge driver `graphify` registrado en .git/config;
# si algún día se decide versionar graph.json, hay que quitar esta línea.
graphify-out/

# Backup files
*.bak
*.bak2
*.bak3
*.before_cors_fix

# Respaldos generados para no perder el trabajo si falla el push
*.bundle
igris-cambios.patch
